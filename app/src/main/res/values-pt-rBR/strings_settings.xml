    <string name="st_t_video_internal_display_resolution_x">Largura personalizada</string>
    <string name="st_d_video_internal_display_resolution_x">Largura informada ao jogo quando o modo de vídeo é Personalizado. O core aceita de 1 a 1920.</string>
    <string name="st_t_video_internal_display_resolution_y">Altura personalizada</string>
    <string name="st_d_video_internal_display_resolution_y">Altura informada ao jogo quando o modo de vídeo é Personalizado. O core aceita de 1 a 1080.</string>
    <string name="st_t_gpu_draw_resolution_scale_threshold">Não ampliar superfícies estreitas</string>
    <string name="st_d_gpu_draw_resolution_scale_threshold">Com a escala acima de 1x, superfícies até esta largura ficam na resolução nativa. Bloom e profundidade de campo costumam quebrar quando ampliados. Use o menor valor que conserta o efeito.</string>
    <string name="st_t_display_postprocess_ffx_cas_additional_sharpness">CAS: nitidez extra</string>
    <string name="st_d_display_postprocess_ffx_cas_additional_sharpness">Quanto de nitidez o AMD CAS acrescenta além do padrão; mais alto é mais nítido e pode mostrar halos.</string>
    <string name="st_t_display_postprocess_ffx_fsr_sharpness_reduction">FSR: redução de nitidez</string>
    <string name="st_d_display_postprocess_ffx_fsr_sharpness_reduction">Quanto o FSR suaviza a nitidez na passada final; 0 é o mais nítido, 2 o mais suave.</string>
    <string name="st_t_display_postprocess_ffx_fsr_max_upsampling_passes">FSR: passadas de ampliação</string>
    <string name="st_d_display_postprocess_ffx_fsr_max_upsampling_passes">Quantas vezes o FSR pode ampliar em sequência quando a tela é muito maior que o jogo. Mais passadas custam GPU.</string>
    <string name="st_t_kernel_kernel_display_gamma_type">Curva de gama da TV</string>
    <string name="st_d_kernel_kernel_display_gamma_type">Gama da tela informada aos jogos. BT.709 é a mais parecida com um Xbox 360 ligado numa HDTV.</string>
    <string name="st_t_kernel_kernel_display_gamma_power">Gama personalizada</string>
    <string name="st_d_kernel_kernel_display_gamma_power">Expoente usado quando a curva é Potência personalizada. O padrão do core é 2,22.</string>
    <string name="st_t_display_present_safe_area_x">Manter pelo menos esta largura</string>
    <string name="st_d_display_present_safe_area_x">Com barras pretas, abaixo de 100 as bordas podem ser cortadas no lugar das barras.</string>
    <string name="st_t_display_present_safe_area_y">Manter pelo menos esta altura</string>
    <string name="st_d_display_present_safe_area_y">Com barras pretas, abaixo de 100 o topo e a base podem ser cortados no lugar das barras.</string>
    <string name="st_t_gpu_async_shader_compilation">Compilação assíncrona de shaders</string>
    <string name="st_d_gpu_async_shader_compilation">Compila shaders novos em segundo plano: sem engasgos numa cena nova, mas os primeiros quadros podem perder um objeto. Desligada, cria cada pipeline na hora: mais engasgos, nada faltando.</string>
    <string name="st_t_gpu_async_shader_vs_interpreter">Interpretar vertex shaders enquanto compilam</string>
    <string name="st_d_gpu_async_shader_vs_interpreter">Desenha vertex shaders novos com o interpretador até a versão compilada ficar pronta, em vez de travar na tradução.</string>
    <string name="st_t_gpu_async_shader_skip_draws">Pular desenhos até o shader ficar pronto</string>
    <string name="st_d_gpu_async_shader_skip_draws">Pula desenhos cujo shader ainda não pode ser usado (tesselação, por exemplo) até ele compilar em segundo plano. Evita engasgos, mas a geometria aparece alguns quadros depois.</string>
    <string name="st_t_gpu_pipeline_storage_precreate">Pré-criar pipelines ao abrir o jogo</string>
    <string name="st_d_gpu_pipeline_storage_precreate">Cria na abertura os pipelines que as sessões anteriores usaram, para não compilarem no meio do jogo. Desligado, ainda reaproveita os shaders guardados.</string>
    <string name="st_t_gpu_store_shaders">Guardar shaders</string>
    <string name="st_d_gpu_store_shaders">Guarda os shaders traduzidos e os carrega quando o jogo abre de novo, para a segunda sessão engasgar menos.</string>
    <string name="st_t_kernel_precise_guest_delays">Esperas precisas do jogo</string>
    <string name="st_d_kernel_precise_guest_delays">Atende as esperas do jogo com precisão abaixo de 1 ms. Uma espera comum do sistema passa do ponto e aumenta o tempo de cada quadro.</string>
    <string name="st_t_apu_apu_performance_hint">Dica de desempenho para o áudio (ADPF)</string>
    <string name="st_d_apu_apu_performance_hint">Registra uma sessão ADPF nas threads de despacho e de áudio para o sistema segurar os clocks no prazo do áudio.</string>
    <string name="st_t_vulkan_adrenotools_force_max_clocks">Forçar clocks máximos da GPU</string>
    <string name="st_d_vulkan_adrenotools_force_max_clocks">Com driver personalizado, pede a GPU no clock máximo. Mais velocidade, mais calor e bateria.</string>
    <string name="st_t_vulkan_adrenotools_turbo_reassert_seconds">Repetir o pedido de clocks máximos a cada</string>
    <string name="st_d_vulkan_adrenotools_turbo_reassert_seconds">O pedido se perde quando o app sai de foco; este intervalo pede de novo depois de voltar. 0 pede só na abertura.</string>
    <string name="st_t_vulkan_vulkan_pipeline_creation_threads">Threads de criação de pipelines</string>
    <string name="st_d_vulkan_vulkan_pipeline_creation_threads">Threads que criam pipelines em segundo plano. 0 cria na hora.</string>
    <string name="st_t_gpu_vulkan_mid_frame_submission_draws">Enviar à GPU a cada N desenhos</string>
    <string name="st_d_gpu_vulkan_mid_frame_submission_draws">Divide o quadro em envios para a GPU trabalhar enquanto a CPU monta o resto. 0 desliga; valores pequenos prejudicam GPUs por tiles.</string>
    <string name="st_t_kernel_guest_scheduler">Agendador do jogo (fibras cooperativas)</string>
    <string name="st_d_kernel_guest_scheduler">Executa as threads do jogo como fibras cooperativas. Vale na próxima abertura.</string>
    <string name="st_t_apu_volume">Volume</string>
    <string name="st_d_apu_volume">Volume de toda a saída de áudio. O menu do jogo continua mudando ao vivo; aqui fica o valor de partida.</string>
    <string name="st_t_apu_apu_aaudio_buffer_bursts">Profundidade do buffer de áudio</string>
    <string name="st_d_apu_apu_aaudio_buffer_bursts">Mais blocos no buffer evitam estalos e aumentam a latência.</string>
    <string name="st_t_apu_apu_aaudio_adaptive_buffer">Buffer de áudio adaptativo</string>
    <string name="st_d_apu_apu_aaudio_adaptive_buffer">Cresce um bloco a cada falha de áudio e volta depois de 30 s calmos, até três vezes a profundidade acima.</string>
    <string name="st_t_apu_xma_decoder">Decodificador XMA</string>
    <string name="st_d_apu_xma_decoder">Implementação usada para decodificar o áudio XMA.</string>
    <string name="st_t_hid_vibration">Vibração do controle</string>
    <string name="st_d_hid_vibration">Liga ou desliga a vibração pedida pelo jogo.</string>
    <string name="st_t_hid_guide_button">Enviar o botão Guia ao jogo</string>
    <string name="st_d_hid_guide_button">Repassa ao jogo os toques no botão Guia do controle.</string>
    <string name="st_t_gpu_clear_memory_page_state">Atualizar o estado das páginas de memória</string>
    <string name="st_d_gpu_clear_memory_page_state">Torna visíveis as escritas da GPU que o jogo lê de volta. Conserta modelos sumidos em títulos da Team Ninja. Custa uma passada por quadro: use por jogo.</string>
    <string name="st_t_gpu_depth_float24_convert_in_pixel_shader">Converter profundidade float24 no pixel shader</string>
    <string name="st_d_gpu_depth_float24_convert_in_pixel_shader">Evita travamentos da GPU (device lost) em Adreno com Turnip em alguns jogos, como Ninja Gaiden II.</string>
    <string name="st_t_gpu_occlusion_query">Consulta de oclusão</string>
    <string name="st_d_gpu_occlusion_query">Como o jogo descobre se algo está visível. Simulada inventa o resultado (mais rápida); Estrita espera a GPU responder.</string>
    <string name="st_t_gpu_readback_resolve_sync">Sincronizar a leitura de resolves</string>
    <string name="st_d_gpu_readback_resolve_sync">Espera a GPU depois de cada cópia para a memória do jogo ficar coerente no mesmo quadro. Desligado copia sem esperar.</string>
    <string name="st_t_gpu_precise_interpolation">Interpolação precisa</string>
    <string name="st_d_gpu_precise_interpolation">Interpola as entradas dos pixel shaders exatamente como o console. Conserta ruído em jogos como Perfect Dark e Tenchu Z.</string>
    <string name="st_t_gpu_depth_bias_shader_offset">Profundidade de decalques no shader</string>
    <string name="st_d_gpu_depth_bias_shader_offset">Evita Z-fighting em jogos que usam valores mínimos de depth bias. Custo pequeno.</string>
    <string name="st_t_gpu_readback_resolve">Leitura de resolves pela CPU</string>
    <string name="st_d_gpu_readback_resolve">UMA lê direto da memória compartilhada; é o único modo que funciona em Adreno.</string>
    <string name="st_t_gpu_memexport_enable">Memexport visível para a CPU</string>
    <string name="st_d_gpu_memexport_enable">Para jogos que leem na CPU o que a GPU exportou.</string>
    <string name="st_t_vulkan_vulkan_allow_reverse_z">Profundidade invertida direto no driver</string>
    <string name="st_d_vulkan_vulkan_allow_reverse_z">Passa ao driver as faixas de profundidade invertidas (inverse-Z). Desligue se o driver errar o desenho.</string>
    <string name="st_t_kernel_stack_size_multiplier_hack">Multiplicador da pilha (hack)</string>
    <string name="st_d_kernel_stack_size_multiplier_hack">Hack para jogos com problemas de setjmp/longjmp.</string>
    <string name="st_t_cpu_collapse_memory_delay_spins">Encurtar esperas por contagem</string>
    <string name="st_d_cpu_collapse_memory_delay_spins">Pula o tempo real de laços de espera do jogo. Desligue neste jogo se ele depender desse tempo.</string>
    <string name="st_t_vulkan_turnip_debug">Modo de depuração do Turnip</string>
    <string name="st_d_vulkan_turnip_debug">sysmem renderiza sem tiles: mais lento, mas evita uma classe de travamentos da GPU Adreno.</string>
    <string name="st_t_vulkan_vulkan_dynamic_rendering">Dynamic rendering</string>
    <string name="st_d_vulkan_vulkan_dynamic_rendering">Usa VK_KHR_dynamic_rendering no lugar dos render passes tradicionais. Pode melhorar ou piorar conforme o driver.</string>
    <string name="st_t_vulkan_vulkan_avoid_geometry_shaders">Evitar geometry shaders</string>
    <string name="st_d_vulkan_vulkan_avoid_geometry_shaders">Em GPUs por tiles (Adreno/Turnip), desvia sprites de pontos e quad lists por caminhos mais baratos. Lido ao iniciar a GPU.</string>
    <string name="st_t_vulkan_vulkan_depth_unorm24">Profundidade D24 nativa</string>
    <string name="st_d_vulkan_vulkan_depth_unorm24">Usa o formato D24_UNORM_S8_UINT quando o driver suporta. Desligado força a emulação em float32, como no driver da própria Adreno.</string>
    <string name="st_t_ui_achievement_notification_position_by_game">Conquista na posição que o jogo pede</string>
    <string name="st_d_ui_achievement_notification_position_by_game">Desligado, a notificação aparece sempre embaixo, no centro.</string>
    <string name="st_t_general_launch_module">Executável a iniciar</string>
    <string name="st_d_general_launch_module">Executável do disco ou pacote a iniciar no lugar do default.xex. Em branco usa o padrão.</string>
    <string name="st_t_storage_mount_memory_unit">Montar unidade de memória (MU)</string>
    <string name="st_d_storage_mount_memory_unit">Monta uma unidade de memória como a do console.</string>
    <string name="st_t_kernel_console_type">Tipo de console</string>
    <string name="st_d_kernel_console_type">Tipo de console informado ao jogo.</string>
    <string name="st_t_kernel_cl">Linha de comando extra para o jogo</string>
    <string name="st_d_kernel_cl">Argumentos repassados ao jogo na abertura.</string>
    <string name="st_t_general_guest_crash_is_fatal">Encerrar quando uma thread do jogo falhar</string>
    <string name="st_d_general_guest_crash_is_fatal">Grava um relatório completo e encerra, em vez de deixar a thread parada (o que parece um travamento). Desligue só para inspecionar.</string>
    <string name="st_t_kernel_apply_title_update">Aplicar title updates</string>
    <string name="st_d_kernel_apply_title_update">Aplica as title updates instaladas quando o jogo abre.</string>
    <string name="st_t_kernel_allow_incompatible_title_update">Permitir title updates incompatíveis</string>
    <string name="st_d_kernel_allow_incompatible_title_update">Aplica title updates mesmo quando a assinatura não bate com o jogo.</string>
    <string name="st_t_kernel_network_enabled">Rede</string>
    <string name="st_d_kernel_network_enabled">Deixa os jogos verem uma conexão de rede.</string>
    <string name="st_t_network_systemlink">System link (LAN)</string>
    <string name="st_d_network_systemlink">Jogue System Link com os aparelhos no mesmo Wi-Fi. Ative em cada um e escolha o modo System Link do jogo. O Halo 3 também precisa do patch \"Allow public IP addresses.\" ativado.</string>
    <string name="st_t_network_systemlink_peers">Outros consoles (VPN)</string>
    <string name="st_d_network_systemlink_peers">Endereços IP de aparelhos em outra rede ou numa VPN (ZeroTier, Tailscale), separados por vírgulas.</string>
    <string name="st_t_content_license_mask">Máscara de licença</string>
    <string name="st_d_content_license_mask">Quais licenças de conteúdo os jogos veem como compradas: nenhuma, a primeira ou todas (libera a versão completa de jogos arcade).</string>
    <string name="st_t_console_video_standard">Padrão de vídeo</string>
    <string name="st_d_console_video_standard">Padrão de vídeo informado aos jogos: NTSC, NTSC-J ou PAL-60.</string>
    <string name="st_t_console_use_50hz_mode">Modo 50 Hz</string>
    <string name="st_d_console_use_50hz_mode">Informa aos jogos uma TV de 50 Hz (PAL).</string>
    <string name="st_t_logging_log_level">Nível de log</string>
    <string name="st_d_logging_log_level">Quanto o emulador escreve no xe.log.</string>
    <string name="st_t_logging_log_mask">Filtro de log</string>
    <string name="st_d_logging_log_mask">Mantém no log só as linhas de um subsistema.</string>
